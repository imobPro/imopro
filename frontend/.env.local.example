# Frontend — variáveis de ambiente (Next.js)
# Copie para .env.local e preencha com os valores reais do seu projeto Supabase.
# NUNCA commite .env.local — apenas este arquivo de exemplo.

# Supabase — obter em app.supabase.com → Projeto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# URL pública da aplicação (usada em redirects de auth)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# URL do backend Express (server-side only — usada pelo route handler que faz
# proxy do download de PDFs do bucket privado de relatórios e pelas queries
# de /configuracoes). next dev ocupa :3000 por padrão, então o backend Express
# precisa ficar em outra porta — rode na raiz com PORT=3001.
BACKEND_URL=http://localhost:3001
