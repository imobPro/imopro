# ─────────────────────────────────────────────────────────────────────────────
# ImobBot SaaS — Variáveis de ambiente
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o arquivo .env no repositório.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Aplicação ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Encontre em: app.supabase.com → Projeto → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# JWT Secret legado do projeto (Settings → API → JWT Secret).
# Usado pelo backend para validar os JWTs emitidos pelo Supabase Auth.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ─── Claude API (Anthropic) ───────────────────────────────────────────────────
# Encontre em: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ─── OpenAI (Whisper — transcrição de áudio) ──────────────────────────────────
# Encontre em: platform.openai.com → API Keys
# Usado exclusivamente para transcrição de áudio via Whisper-1
OPENAI_API_KEY=sk-your-openai-key-here

# Modelos conforme estratégia definida no CLAUDE.md
CLAUDE_DEFAULT_MODEL=claude-sonnet-4-6         # Desenvolvimento do dia a dia
CLAUDE_FAST_MODEL=claude-haiku-4-5-20251001    # Tarefas rápidas e boilerplate
CLAUDE_SMART_MODEL=claude-opus-4-6             # Arquitetura e decisões críticas

# ─── Z-API (WhatsApp) ─────────────────────────────────────────────────────────
# Encontre em: app.z-api.io → Instância → Configurações
#
# A Z-API tem dois níveis de credencial:
# - ACCOUNT TOKEN: token da conta-mãe (Settings da conta). Usado para criar
#   instâncias dinamicamente quando o ImobPro provisiona Z-API automaticamente
#   (modo `tenants.zapi_account_managed=true`, default da Fase 3).
# - INSTANCE ID + TOKEN: credenciais por instância. No Sprint 9 deixam de vir
#   do .env e passam a ser gravadas em `tenants.zapi_instance_id/token` durante
#   o provisionamento. Mantemos as 3 vars abaixo para o piloto manual atual.
ZAPI_BASE_URL=https://api.z-api.io
ZAPI_ACCOUNT_TOKEN=your-account-token   # Conta Z-API → Settings → Account Token
ZAPI_INSTANCE_ID=your-instance-id       # Instância do piloto manual (legado)
ZAPI_TOKEN=your-instance-token          # Token da instância acima (legado)
# ZAPI_CLIENT_TOKEN removido no Sprint 9.6: /webhook/whatsapp autentica por
# posse do instanceId (resolveTenantByInstance). Piloto manual legado: gravar
# instanceId em tenants.zapi_instance_id via SQL — checklist-producao.md.

# URL pública do BACKEND (este serviço, ex.: Railway). A Z-API posta aqui as
# callbacks das instâncias provisionadas no onboarding: mensagens recebidas
# (/webhook/whatsapp) e conexão/desconexão (/webhook/zapi-status). Sem barra final.
BACKEND_PUBLIC_URL=https://your-backend.up.railway.app

# ─── Fase 3 — Trial e billing ─────────────────────────────────────────────────
# Limites do trial gratuito. Cliente perde acesso da IA ao estourar o que vier
# primeiro: tempo OU mensagens. Após estourar, mensagens caem em
# saveIncomingMessagesOnly e o painel continua acessível.
TRIAL_DAYS=7
TRIAL_MESSAGE_LIMIT=50

# ─── Redis / BullMQ ──────────────────────────────────────────────────────────
# Redis para fila de processamento de mensagens
REDIS_URL=redis://localhost:6379

# ─── Stripe (Pagamentos) ──────────────────────────────────────────────────────
# Encontre em: dashboard.stripe.com → Developers → API Keys
STRIPE_PUBLISHABLE_KEY=pk_test_your-key-here
STRIPE_SECRET_KEY=sk_test_your-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ─── Asaas (Pagamentos — alternativa brasileira) ──────────────────────────────
# Encontre em: app.asaas.com → Configurações → Integrações
ASAAS_API_KEY=your-asaas-api-key
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3   # Trocar para produção depois

# ─── Resend (Envio de relatórios automáticos) ────────────────────────────────
# Encontre em: resend.com → API Keys
# Validar domínio em Domains antes de usar em produção (relatorios@seudominio.com.br)
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL="ImobPro <relatorios@imobpro.com.br>"

# ─── Relatórios ──────────────────────────────────────────────────────────────
# Dias sem mensagem para marcar lead como inativo (default 7)
REPORTS_INACTIVE_DAYS=7

# ─── Sentry (Observabilidade) ────────────────────────────────────────────────
# Opcional. Quando ausente, captura de erros é desabilitada (no-op).
# Crie um projeto Node.js em sentry.io e copie o DSN.
# SENTRY_ENVIRONMENT default = NODE_ENV; sobrescrever para distinguir
# staging/production no mesmo projeto.
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# ─── Frontend — Next.js (variáveis públicas) ─────────────────────────────────
# Estas variáveis são expostas ao navegador — não coloque secrets aqui
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
